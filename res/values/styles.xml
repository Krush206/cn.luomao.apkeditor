<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="text_appearance_primary_normal">
        <item name="android:textSize">@dimen/text_size_normal</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="text_appearance_primary_smaller">
        <item name="android:textSize">@dimen/text_size_smaller</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="text_appearance_secondary_normal">
        <item name="android:textSize">@dimen/text_size_normal</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="text_appearance_secondary_smaller">
        <item name="android:textSize">@dimen/text_size_smaller</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="text_appearance_minor_smaller">
        <item name="android:textSize">@dimen/text_size_smaller</item>
        <item name="android:textColor">@color/text_minor</item>
    </style>
    <style name="theme_black" parent="@android:style/Theme.Holo">
        <item name="android:windowBackground">@color/main_background</item>
    </style>
</resources>
