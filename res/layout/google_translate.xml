<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:id="@id/linearLayout1" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textAppearance="@style/text_appearance_primary_normal" android:layout_gravity="center_vertical" android:id="@id/textView1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_translate_from" />
        <Spinner android:entries="@array/array_language" android:layout_gravity="center_vertical" android:id="@id/languageSource" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1.0" />
        <TextView android:id="@id/textView4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1.0" />
        <ImageView android:id="@id/btnShiftColumn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/ic_menu_google_translate" />
    </LinearLayout>
    <EditText android:textSize="@dimen/text_size_normal" android:id="@id/textSource" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1.0" android:inputType="textMultiLine" />
    <LinearLayout android:id="@id/linearLayout2" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textAppearance="@style/text_appearance_primary_normal" android:layout_gravity="center_vertical" android:id="@id/textView2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_translate_to" />
        <Spinner android:entries="@array/array_language" android:id="@id/languageTarget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1.0" />
        <TextView android:id="@id/textView3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" " android:layout_weight="1.0" />
        <Button android:id="@id/btnTranslate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_translate" />
    </LinearLayout>
    <EditText android:textSize="@dimen/text_size_normal" android:id="@id/textTarget" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1.0" android:inputType="textMultiLine">
        <requestFocus />
    </EditText>
</LinearLayout>
